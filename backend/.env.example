# 复制为 .env 并填入真实值
# ---- LLM 配置 ----
# OpenAI 官方: base url留空, 用 OPENAI_API_KEY
# 通义千问(DashScope)兼容模式: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-xxxx
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ---- 成本控制 ----
MAX_LLM_CALLS_PER_RUN=6
